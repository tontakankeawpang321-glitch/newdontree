<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Car Care - ศูนย์รวมคาร์แคร์และอู่ซ่อมสี</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');
        
        :root {
            --brand-primary: #0284c7; /* Sky-600 */
            --brand-secondary: #0c4a6e; /* Sky-900 */
            --brand-bg: #f0f9ff; /* Sky-50 */
        }

        body { 
            font-family: 'Sarabun', sans-serif; 
            background-color: #cbd5e1;
            color: #334155;
        }

        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        
        .image-slot {
            width: 100%;
            aspect-ratio: 1/1;
            border: 2px dashed #bae6fd;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #ffffff;
            position: relative;
            overflow: hidden;
        }
        .image-slot:hover { border-color: var(--brand-primary); background: #e0f2fe; }
        .image-slot img { width: 100%; height: 100%; object-fit: cover; }
        
        .fade-in { animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .category-chip {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.1rem;
            border-radius: 1rem;
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.2s;
            border: 1px solid #e2e8f0;
        }

        .product-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .product-card:active { transform: scale(0.98); }

        /* Lightbox Animation */
        .zoom-in { animation: zoomIn 0.3s ease-out forwards; }
        @keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        /* Map Container */
        .map-container iframe {
            width: 100%;
            height: 100%;
            border-radius: 1rem;
            border: 0;
        }

        /* Heart Animation */
        .heart-click { animation: heartBeat 0.3s ease-in-out; }
        @keyframes heartBeat {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body class="min-h-screen flex justify-center items-center p-0 md:p-4 bg-slate-200">

    <div class="w-full max-w-md bg-white shadow-2xl h-screen md:h-[850px] md:rounded-[3rem] overflow-hidden relative flex flex-col border border-slate-300" id="app">
        
        <!-- ================= หน้าหลัก (HOME) ================= -->
        <div id="view-home" class="view h-full flex flex-col bg-slate-50 relative">
            <header class="bg-white px-6 pt-8 pb-4 z-20 border-b border-slate-100 rounded-b-[2rem] shadow-sm">
                <div class="flex justify-between items-center mb-6">
                    <div class="flex items-center gap-3">
                        <div class="bg-sky-600 p-2.5 rounded-2xl text-white shadow-lg shadow-sky-200">
                            <i data-lucide="car-front"></i>
                        </div>
                        <div>
                            <h1 class="text-xl font-bold tracking-tight text-slate-800">Car Care</h1>
                            <p class="text-[10px] text-sky-500 font-bold uppercase tracking-widest">ดูแลรถ ครบวงจร ใกล้บ้าน</p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <!-- ปุ่มรายการโปรด -->
                        <button onclick="showFavorites()" class="w-10 h-10 flex items-center justify-center rounded-full bg-pink-50 text-pink-400 hover:text-pink-600 hover:bg-pink-100 transition-colors shadow-sm">
                            <i data-lucide="heart" width="18" class="fill-current"></i>
                        </button>
                        <!-- ปุ่มรีเฟรช -->
                        <button onclick="fetchPosts()" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm">
                            <i data-lucide="refresh-cw" width="18"></i>
                        </button>
                    </div>
                </div>
                
                <div class="space-y-3 mb-4">
                    <!-- แถวตัวกรอง จังหวัด และ อำเภอ -->
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <select id="filter-province" onchange="handleProvinceChange('filter-province', 'filter-district'); renderHome();" 
                                class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 appearance-none focus:ring-2 focus:ring-sky-500 outline-none truncate">
                                <option value="">ทุกจังหวัด</option>
                            </select>
                            <i data-lucide="map-pin" class="absolute left-3 top-3.5 text-sky-500" width="16"></i>
                        </div>
                        <div class="relative flex-1">
                            <select id="filter-district" onchange="renderHome()" disabled
                                class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 appearance-none focus:ring-2 focus:ring-sky-500 outline-none truncate disabled:bg-slate-100 disabled:text-slate-400">
                                <option value="">ทุกพื้นที่</option>
                            </select>
                            <i data-lucide="map" class="absolute left-3 top-3.5 text-slate-400" width="16"></i>
                        </div>
                    </div>
                </div>

                <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide" id="category-filters"></div>
            </header>

            <div id="post-list" class="flex-1 overflow-y-auto p-5 space-y-5 pb-5 relative bg-slate-50"></div>

            <!-- Bottom Navigation Bar -->
            <div class="bg-white border-t border-slate-100 px-6 py-2 flex justify-between items-center shadow-[0_-5px_20px_rgba(0,0,0,0.03)] z-30">
                <!-- Home Tab -->
                <button onclick="router.navigate('home')" class="flex-1 flex flex-col items-center gap-1 text-sky-600 transition-colors pt-2">
                    <i data-lucide="home" width="24"></i>
                    <span class="text-[10px] font-bold">หน้าหลัก</span>
                </button>

                <!-- Create Tab (Center Pop-up) -->
                <button onclick="router.navigate('create')" class="flex-1 flex flex-col items-center -mt-10 group relative z-40">
                    <div class="w-16 h-16 bg-sky-600 text-white rounded-full flex items-center justify-center shadow-xl shadow-sky-200 group-active:scale-95 transition-all border-4 border-slate-50">
                        <i data-lucide="plus" width="32"></i>
                    </div>
                    <span class="text-[10px] font-bold text-slate-500 mt-1 group-hover:text-sky-600">ลงประกาศ</span>
                </button>

                <!-- Near Me Tab -->
                <a href="https://www.google.com/maps/search/car+care+near+me" target="_blank" class="flex-1 flex flex-col items-center gap-1 text-slate-400 hover:text-sky-600 transition-colors pt-2">
                    <i data-lucide="map-pin" width="24"></i>
                    <span class="text-[10px] font-bold">ใกล้ฉัน</span>
                </a>
            </div>
        </div>

        <!-- ================= หน้ารายละเอียด (DETAIL) ================= -->
        <div id="view-detail" class="view h-full flex flex-col bg-white hidden overflow-y-auto">
            <div id="detail-content"></div>
        </div>

        <!-- ================= หน้าลงประกาศงาน (CREATE) ================= -->
        <div id="view-create" class="view h-full flex flex-col bg-white hidden">
            <header class="px-6 py-6 flex items-center justify-between border-b border-slate-100">
                <button onclick="router.back()" class="p-2 hover:bg-slate-50 rounded-full text-slate-400 transition-colors">
                    <i data-lucide="x"></i>
                </button>
                <h2 class="text-lg font-bold text-slate-800">ลงประกาศร้าน / บริการ</h2>
                <div class="w-8"></div>
            </header>

            <form id="create-form" class="flex-1 overflow-y-auto p-6 space-y-8 pb-12">
                <!-- (Form Content Same as Previous) -->
                <div class="space-y-4">
                    <label class="text-sm font-bold text-slate-700 flex items-center gap-2">
                        <i data-lucide="image" width="18" class="text-sky-500"></i>
                        รูปหน้าร้าน / ผลงาน (สูงสุด 3 รูป)
                    </label>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="image-slot" id="slot-0" onclick="triggerFileInput(0)">
                            <i data-lucide="camera" class="text-slate-300 mb-1" width="20"></i>
                            <p class="text-[8px] text-slate-400 font-bold uppercase">รูปที่ 1</p>
                            <input type="file" id="file-0" accept="image/*" class="hidden" onchange="handleFile(event, 0)">
                        </div>
                        <div class="image-slot" id="slot-1" onclick="triggerFileInput(1)">
                            <i data-lucide="camera" class="text-slate-300 mb-1" width="20"></i>
                            <p class="text-[8px] text-slate-400 font-bold uppercase">รูปที่ 2</p>
                            <input type="file" id="file-1" accept="image/*" class="hidden" onchange="handleFile(event, 1)">
                        </div>
                        <div class="image-slot" id="slot-2" onclick="triggerFileInput(2)">
                            <i data-lucide="camera" class="text-slate-300 mb-1" width="20"></i>
                            <p class="text-[8px] text-slate-400 font-bold uppercase">รูปที่ 3</p>
                            <input type="file" id="file-2" accept="image/*" class="hidden" onchange="handleFile(event, 2)">
                        </div>
                    </div>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">ชื่อร้าน / ชื่อบริการ</label>
                        <input required name="title" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm focus:border-sky-500 focus:bg-white outline-none transition-all" placeholder="เช่น อู่ช่างเอก เคาะพ่นสี, คาร์แคร์ล้างรถดูดฝุ่น">
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">หมวดหมู่บริการ</label>
                            <select name="category" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm outline-none appearance-none focus:border-sky-500">
                                <option>ล้างรถ/ดูดฝุ่น</option>
                                <option>ซ่อมรอยบุบ</option>
                                <option>เคาะพ่นสี</option>
                                <option>ขัด/เคลือบเงา</option>
                                <option>ซ่อมบำรุง/ถ่ายน้ำมัน</option>
                                <option>ยาง/ช่วงล่าง</option>
                                <option>อื่นๆ</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">รูปแบบบริการ</label>
                            <select name="jobType" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm outline-none appearance-none focus:border-sky-500 font-bold text-sky-600">
                                <option>ที่ร้าน (Shop)</option>
                                <option>นอกสถานที่ (Delivery)</option>
                                <option>ฉุกเฉิน 24ชม.</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">ราคาเริ่มต้น/ประเมิน</label>
                            <input required name="wage" type="text" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm focus:border-sky-500 outline-none" placeholder="เช่น 500">
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">หน่วยราคา</label>
                            <select name="paymentType" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm outline-none appearance-none focus:border-sky-500">
                                <option>เริ่มต้น</option>
                                <option>เหมาจ่าย</option>
                                <option>ต่อชิ้น</option>
                                <option>ประเมินหน้างาน</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">จังหวัด (พื้นที่)</label>
                            <select name="province" id="create-province" onchange="handleProvinceChange('create-province', 'create-district')" required class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm outline-none appearance-none">
                                <option value="">เลือกจังหวัด</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">อำเภอ/เขต</label>
                            <select name="district" id="create-district" required disabled class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm outline-none appearance-none disabled:bg-slate-50 disabled:text-slate-300">
                                <option value="">เลือกพื้นที่</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">ID LINE (สำคัญ)</label>
                            <input required name="lineId" type="text" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm focus:border-sky-500 outline-none font-bold text-green-600" placeholder="ระบุไอดีไลน์">
                        </div>
                         <div>
                            <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">เบอร์โทรศัพท์</label>
                            <input name="phone" type="text" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm focus:border-sky-500 outline-none" placeholder="08X-XXX-XXXX">
                        </div>
                    </div>

                    <div>
                        <label class="text-[10px] font-black text-slate-400 mb-2 block uppercase tracking-[0.1em]">รายละเอียดเพิ่มเติม</label>
                        <textarea name="description" rows="4" class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl p-4 text-sm focus:border-sky-500 outline-none" placeholder="อธิบายบริการ, เวลาทำการ, โปรโมชั่น, จุดสังเกตหน้าร้าน"></textarea>
                    </div>
                </div>

                <div class="sticky bottom-0 bg-white p-6 border-t border-slate-100 flex gap-3 z-30">
                    <button type="button" onclick="router.back()" class="flex-1 bg-slate-100 text-slate-500 py-5 rounded-2xl font-bold active:scale-95 transition-all">
                        ยกเลิก
                    </button>
                    <button type="submit" id="submit-btn" class="flex-[2] bg-sky-600 text-white py-5 rounded-2xl font-bold text-lg shadow-xl shadow-sky-100 active:scale-95 transition-all">
                        ลงประกาศ
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lightbox Overlay -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/95 hidden flex items-center justify-center p-4 fade-in backdrop-blur-sm" onclick="closeLightbox()">
        <button class="absolute top-6 right-6 text-white p-3 rounded-full bg-white/10 hover:bg-white/20 transition-colors z-50">
            <i data-lucide="x" width="24"></i>
        </button>
        <img id="lightbox-img" src="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl zoom-in" onclick="event.stopPropagation()">
    </div>

