        function escapeHTML(str = '') {
            return str.replace(/[&<>"']/g, m =>
                ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m])
            );
        }
        
        function getDirectImage(url) {
            if (!url) {
                return 'https://images.unsplash.com/photo-1601362840469-51e4d8d58785?w=600&q=80';
            }
            url = url.trim();
            let fileId = null;
            if (url.includes('/d/')) {
                const m = url.match(/\/d\/([^/]+)/);
                if (m) fileId = m[1];
            }
            if (!fileId && url.includes('id=')) {
                const m = url.match(/id=([^&]+)/);
                if (m) fileId = m[1];
            }
            if (fileId) {
                return `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000`;
            }
            return url;
        }

