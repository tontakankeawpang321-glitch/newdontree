        // ================= FAVORITES LOGIC =================

        function toggleFavorite(e, id) {
            if(e) e.stopPropagation();
            let favs = JSON.parse(localStorage.getItem('carcare_favs') || '[]');
            const idx = favs.indexOf(id);
            if (idx === -1) {
                favs.push(id);
                // Animation for success
                const btn = e ? e.currentTarget : null;
                if(btn) {
                    btn.classList.add('heart-click');
                    setTimeout(() => btn.classList.remove('heart-click'), 300);
                }
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success', 
                    title: 'บันทึกรายการโปรดแล้ว', showConfirmButton: false, timer: 1500
                });
            } else {
                favs.splice(idx, 1);
            }
            localStorage.setItem('carcare_favs', JSON.stringify(favs));
            
            // Re-render based on current view
            if (state.currentView === 'home') renderHome();
            if (state.currentView === 'detail') renderDetail(id);
        }

