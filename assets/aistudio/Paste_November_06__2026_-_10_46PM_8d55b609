        function triggerFileInput(index) { document.getElementById(`file-${index}`).click(); }

        function handleFile(event, index) {
            const file = event.target.files[0];
            if(!file) return;
            
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire('ขนาดไฟล์ใหญ่เกินไป', 'กรุณาอัปโหลดรูปภาพขนาดไม่เกิน 5MB', 'warning');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                state.images[index] = e.target.result;
                const slot = document.getElementById(`slot-${index}`);
                slot.innerHTML = `<img src="${e.target.result}" alt="Preview"><button type="button" onclick="removeImage(event, ${index})" class="absolute top-1 right-1 bg-red-500 text-white rounded-full p-1 shadow-lg hover:bg-red-600 transition-colors"><i data-lucide="x" width="12"></i></button>`;
                lucide.createIcons();
            };
            reader.readAsDataURL(file);
        }

        function removeImage(e, index) {
            e.stopPropagation();
            state.images[index] = null;
            const slot = document.getElementById(`slot-${index}`);
            slot.innerHTML = `<i data-lucide="camera" class="text-slate-300 mb-1" width="20"></i><p class="text-[8px] text-slate-400 font-bold uppercase">รูปที่ ${index + 1}</p><input type="file" id="file-${index}" accept="image/*" class="hidden" onchange="handleFile(event, ${index})">`;
